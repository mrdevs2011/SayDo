<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#152868" />
        </shape>
    </item>
    <!-- soft vignette edge -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="80%p"
                android:centerX="0.5"
                android:centerY="0.35"
                android:startColor="#1B3A8C"
                android:endColor="#0F1F52" />
        </shape>
    </item>
</layer-list>
