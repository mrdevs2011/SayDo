{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/mcp.ts": { "maxDuration": 300 },
    "api/device/poll.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/mcp/:token", "destination": "/api/mcp?token=:token" },
    { "source": "/", "destination": "/api/health" }
  ]
}
